<UserControl x:Class="DiskPro.App.Views.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"><Run Text="已选 "/><Run Text="{Binding SelectedText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
          <Button Style="{StaticResource DangerButton}" Command="{Binding CleanCommand}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="清除所选痕迹"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="扫描隐私痕迹"/></StackPanel>
          </Button>
          <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessSoftBrush}" Margin="16,0,0,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
              <TextBlock Text="已保存的密码、书签、浏览器设置永不触碰" Foreground="{DynamicResource SuccessBrush}"/></StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ItemCount, Converter={StaticResource CountToVis}}">
        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource JunkCategoryTemplate}"/>
      </ScrollViewer>
      <ContentControl Style="{StaticResource EmptyState}" Tag="&#xE72E;" Visibility="{Binding ItemCount, Converter={StaticResource ZeroToVis}}">
        <StackPanel>
          <TextBlock Text="保护你的隐私" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
          <TextBlock Text="扫描 Chrome / Edge / Firefox 的浏览历史、Cookie、表单记录，以及系统“最近使用”和跳转列表。所有项目默认不勾选，需要你手动确认。" Style="{StaticResource Muted}" MaxWidth="520" TextAlignment="Center" Margin="0,8,0,16"/>
          <Button Style="{StaticResource PrimaryButton}" Content="扫描隐私痕迹" Command="{Binding ScanCommand}" HorizontalAlignment="Center" Padding="28,0"/>
        </StackPanel>
      </ContentControl>
    </Grid>
  </DockPanel>
</UserControl>
