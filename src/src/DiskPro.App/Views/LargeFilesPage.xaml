<UserControl x:Class="DiskPro.App.Views.LargeFilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
      <WrapPanel>
        <TextBlock Text="扫描位置" Style="{StaticResource ToolbarLabel}"/>
        <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
        <Button Content="浏览…" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" Margin="6,0,16,0"/>
        <TextBlock Text="最小大小" Style="{StaticResource ToolbarLabel}"/>
        <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" Width="80" ToolTip="例如 100MB、1GB"/>
        <TextBlock Text="Top" Style="{StaticResource ToolbarLabel}" Margin="16,0,8,0"/>
        <TextBox Text="{Binding TopN, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
        <TextBlock Text="类型" Style="{StaticResource ToolbarLabel}" Margin="16,0,8,0"/>
        <ComboBox ItemsSource="{Binding TypeFilters}" SelectedIndex="{Binding TypeIndex}" Width="200"/>
        <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="16,0,0,0"/>
      </WrapPanel>
    </Border>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="删除所选" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
      <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </DockPanel>
    <Border Style="{StaticResource ListCard}">
      <DataGrid ItemsSource="{Binding Files}" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="文件名" Binding="{Binding Name, Mode=OneWay}" Width="2*" IsReadOnly="True"/>
          <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" SortMemberPath="Size" Width="90" IsReadOnly="True"/>
          <DataGridTextColumn Header="类型" Binding="{Binding Type, Mode=OneWay}" Width="70" IsReadOnly="True"/>
          <DataGridTextColumn Header="修改时间" Binding="{Binding Modified, Mode=OneWay}" Width="130" IsReadOnly="True"/>
          <DataGridTextColumn Header="位置" Binding="{Binding Directory, Mode=OneWay}" Width="3*" IsReadOnly="True"/>
          <DataGridTemplateColumn Width="70">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="&#xE8DA;" ToolTip="定位" Style="{StaticResource IconButton}"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
