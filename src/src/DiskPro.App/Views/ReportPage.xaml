<UserControl x:Class="DiskPro.App.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-12,4">
      <Border Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="累计释放空间" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TotalFreedText}" Style="{StaticResource Number}" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="本月释放" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MonthText}" Style="{StaticResource Number}" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="累计清理次数" Style="{StaticResource Caption}"/><TextBlock Text="{Binding RunsText}" Style="{StaticResource Number}" Margin="0,4,0,0"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12">
        <StackPanel>
          <TextBlock Text="磁盘健康报告" Style="{StaticResource Caption}"/>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Margin="0,8,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="导出 HTML 报告"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </UniformGrid>
    <TextBlock DockPanel.Dock="Top" Text="清理记录" Style="{StaticResource H2}" Margin="2,0,0,10"/>
    <Border Style="{StaticResource ListCard}">
      <Grid>
        <DataGrid ItemsSource="{Binding Records}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="150"/>
            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="*"/>
            <DataGridTextColumn Header="释放空间" Binding="{Binding Freed}" Width="110"/>
            <DataGridTextColumn Header="项目" Binding="{Binding Items}" Width="160"/>
            <DataGridTextColumn Header="方式" Binding="{Binding Mode}" Width="90"/>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource EmptyState}" Tag="&#xE9F9;" Visibility="{Binding Records.Count, Converter={StaticResource ZeroToVis}}">
          <TextBlock Text="还没有清理记录。完成第一次清理后，这里会显示每次释放的空间。" Style="{StaticResource Muted}"/>
        </ContentControl>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
