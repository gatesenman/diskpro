<UserControl x:Class="DiskPro.App.Views.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
      <Button Content="检测系统信息" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="执行清理" Style="{StaticResource PrimaryButton}" Command="{Binding DismCommand}" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="组件存储清理（WinSxS）" Style="{StaticResource H3}"/>
              <TextBlock Text="DISM /Online /Cleanup-Image /StartComponentCleanup —— 微软官方方式清理被取代的系统组件，绝不直接删除 WinSxS 文件。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="关闭休眠" Style="{StaticResource DangerButton}" Command="{Binding HiberOffCommand}"/>
              <Button Content="开启休眠" Style="{StaticResource SecondaryButton}" Command="{Binding HiberOnCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="休眠文件 hiberfil.sys" Style="{StaticResource H3}"/>
              <TextBlock Text="{Binding HiberText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="性能选项…" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPerfCommand}" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="虚拟内存 pagefile.sys" Style="{StaticResource H3}"/>
              <TextBlock Text="{Binding PageText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="删除 Windows.old" Style="{StaticResource DangerButton}" Command="{Binding WinOldCommand}" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="以前的 Windows 安装（Windows.old）" Style="{StaticResource H3}"/>
              <TextBlock Text="{Binding WinOldText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="系统保护…" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSysPropsCommand}" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="系统还原点占用" Style="{StaticResource H3}"/>
              <TextBlock Text="{Binding RestoreText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0" MaxHeight="140"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="删除所选驱动包" Style="{StaticResource DangerButton}" Command="{Binding RemoveDriversCommand}"/>
              <StackPanel>
                <TextBlock Text="第三方驱动包（pnputil）" Style="{StaticResource H3}"/>
                <TextBlock Text="列出 DriverStore 中的 oem*.inf；正在使用的驱动 pnputil 会拒绝删除。请只删除确认不再需要的旧版本。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Drivers}" MaxHeight="260" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="发布名称" Binding="{Binding Item.PublishedName, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="提供商" Binding="{Binding Item.Provider, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="类别" Binding="{Binding Item.ClassName, Mode=OneWay}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="版本" Binding="{Binding Item.Version, Mode=OneWay}" Width="200" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="命令输出" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
