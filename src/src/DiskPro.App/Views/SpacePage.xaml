<UserControl x:Class="DiskPro.App.Views.SpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
      <WrapPanel>
        <TextBlock Text="分析位置" Style="{StaticResource ToolbarLabel}"/>
        <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        <Button Content="浏览…" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" Margin="6,0,16,0"/>
        <TextBlock Text="树深度" Style="{StaticResource ToolbarLabel}"/>
        <TextBox Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
        <Button Content="开始分析" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="16,0,0,0"/>
      </WrapPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0" Padding="8">
        <TreeView ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                  SelectedItemChanged="Tree_SelectedItemChanged">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <Grid Margin="0,2" MinWidth="320">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1" Margin="6,0">
                  <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right"/>
              </Grid>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="&#xE8DA;" ToolTip="打开" Style="{StaticResource IconButton}" Command="{Binding OpenCommand}"/>
            <Button DockPanel.Dock="Right" Content="上一级" Style="{StaticResource SecondaryButton}" Command="{Binding UpCommand}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="提示：点击方块下钻，右侧树与之联动" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
          <v:TreemapControl x:Name="Treemap" Node="{Binding Current}" NodeClicked="Treemap_NodeClicked"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
