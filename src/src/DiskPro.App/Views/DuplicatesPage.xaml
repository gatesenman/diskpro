<UserControl x:Class="DiskPro.App.Views.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
      <WrapPanel>
        <TextBlock Text="查找位置" Style="{StaticResource ToolbarLabel}"/>
        <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        <Button Content="浏览…" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" Margin="6,0,16,0"/>
        <TextBlock Text="最小大小" Style="{StaticResource ToolbarLabel}"/>
        <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
        <Button Content="开始查找" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="16,0,0,0"/>
      </WrapPanel>
    </Border>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="删除所选" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="自动选择：保留最新" Style="{StaticResource SecondaryButton}" Command="{Binding KeepNewestCommand}"/>
        <Button Content="自动选择：保留最旧" Style="{StaticResource SecondaryButton}" Command="{Binding KeepOldestCommand}" Margin="8,0,0,0"/>
        <Button Content="清除选择" Style="{StaticResource SecondaryButton}" Command="{Binding ClearSelectionCommand}" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource AccentBrush}"/>
      </StackPanel>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}" VirtualizingPanel.IsVirtualizing="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding HashShort, StringFormat='SHA256 {0}…'}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11"/>
                  <TextBlock FontWeight="SemiBold"><Run Text="{Binding FirstName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Header, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal"/></TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="&#xE8DA;" ToolTip="定位" Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Modified}" Width="130" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Path}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
