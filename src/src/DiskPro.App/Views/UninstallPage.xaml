<UserControl x:Class="DiskPro.App.Views.UninstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="扫描残留" Style="{StaticResource SecondaryButton}" Command="{Binding ScanLeftoversCommand}" Margin="8,0,0,0"/>
        <Button Content="卸载所选" Style="{StaticResource DangerButton}" Command="{Binding UninstallCommand}" Margin="8,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="刷新列表" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}"/>
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="12,0,0,0" ToolTip="按名称或发布者搜索"/>
        <TextBlock Text="排序：" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Button Content="名称" Style="{StaticResource SecondaryButton}" Command="{Binding SortCommand}" CommandParameter="Name"/>
        <Button Content="大小" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Command="{Binding SortCommand}" CommandParameter="Size"/>
        <Button Content="日期" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Command="{Binding SortCommand}" CommandParameter="InstallDate"/>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" MaxHeight="230"
            Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="清理所选残留" Style="{StaticResource DangerButton}" Command="{Binding CleanLeftoversCommand}"/>
          <TextBlock Text="可能的残留文件夹（请仔细核对，默认不勾选）" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
          <Run Text="注册表残留提示（仅供参考，DiskPro 不会自动删除注册表）："/>
          <Run Text="{Binding RegistryHints.Count, Mode=OneWay}"/><Run Text=" 项，可在 regedit 中核对。"/>
        </TextBlock>
        <ListBox ItemsSource="{Binding Leftovers}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Item}"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource ListCard}">
      <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Single" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="3*"/>
          <DataGridTextColumn Header="发布者" Binding="{Binding Publisher, Mode=OneWay}" Width="2*"/>
          <DataGridTextColumn Header="版本" Binding="{Binding Version, Mode=OneWay}" Width="110"/>
          <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" SortMemberPath="Size" Width="90"/>
          <DataGridTextColumn Header="安装日期" Binding="{Binding InstallDateText, Mode=OneWay}" SortMemberPath="InstallDate" Width="100"/>
          <DataGridTextColumn Header="架构" Binding="{Binding Arch, Mode=OneWay}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
