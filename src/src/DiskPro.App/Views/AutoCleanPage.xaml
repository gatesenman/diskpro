<UserControl x:Class="DiskPro.App.Views.AutoCleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
              <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource Surface3Brush}">
                  <TextBlock Text="{Binding TaskStateText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <TextBlock Text="定时自动清理" Style="{StaticResource H2}"/>
              </DockPanel>
              <TextBlock Text="通过 Windows 任务计划程序在后台运行，只清理“安全”级别的垃圾（临时文件、缓存、错误报告等），不会触碰个人文件、回收站和隐私数据。" Style="{StaticResource Muted}" Margin="0,6,0,14"/>
              <WrapPanel>
                <TextBlock Text="频率" Style="{StaticResource ToolbarLabel}"/>
                <ComboBox ItemsSource="{Binding Frequencies}" SelectedIndex="{Binding FrequencyIndex}" Width="100" Margin="0,0,16,8"/>
                <TextBlock Text="时间" Style="{StaticResource ToolbarLabel}"/>
                <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,16,8" ToolTip="24 小时制，例如 12:30"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="启用 / 更新计划" Command="{Binding EnableCommand}"/>
                <Button Content="关闭自动清理" Command="{Binding DisableCommand}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource GhostButton}" Content="立即执行一次" Command="{Binding RunNowCommand}" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource WarningSoftBrush}">
              <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource WarningBrush}"/>
            </Border>
            <StackPanel>
              <TextBlock Text="托盘与空间提醒" Style="{StaticResource H2}" Margin="0,0,0,12"/>
              <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding EnableTray}" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="在系统托盘显示 DiskPro 图标"/><TextBlock Text="可从托盘快速打开主界面或执行智能扫描" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12" IsEnabled="{Binding EnableTray}">
                <StackPanel><TextBlock Text="关闭窗口时最小化到托盘"/><TextBlock Text="需要退出时请在托盘图标右键菜单中选择“退出”" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding LowDiskAlert}" Margin="0,0,0,12" IsEnabled="{Binding EnableTray}">
                <StackPanel><TextBlock Text="C 盘空间不足时提醒"/><TextBlock Text="每 30 分钟检查一次，6 小时内最多提醒一次" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="提醒阈值：剩余空间低于" Style="{StaticResource ToolbarLabel}"/>
                <TextBox Text="{Binding LowDiskThresholdGb}" Width="64"/>
                <TextBlock Text="GB" Style="{StaticResource ToolbarLabel}" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
