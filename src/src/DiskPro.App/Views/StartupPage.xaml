<UserControl x:Class="DiskPro.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
      <Button Content="刷新启动项" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}"/>
      <TextBlock Text="取消勾选即禁用（与任务管理器“启动”页一致，可随时恢复）" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
    <Border Style="{StaticResource ListCard}">
      <DataGrid ItemsSource="{Binding Items}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="启用" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="200" IsReadOnly="True"/>
          <DataGridTextColumn Header="来源" Binding="{Binding LocationText, Mode=OneWay}" Width="170" IsReadOnly="True"/>
          <DataGridTextColumn Header="命令" Binding="{Binding Command, Mode=OneWay}" Width="*" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
