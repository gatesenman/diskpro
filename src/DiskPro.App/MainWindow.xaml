<Window x:Class="DiskPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskPro.App.ViewModels"
        xmlns:v="clr-namespace:DiskPro.App.Views"
        Title="DiskPro C盘清理大师" Height="800" Width="1280" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/DiskPro.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:JunkViewModel}"><v:JunkPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PrivacyViewModel}"><v:PrivacyPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChatAppViewModel}"><v:ChatAppPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:EmptyFoldersViewModel}"><v:EmptyFoldersPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}"><v:LargeFilesPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SpaceViewModel}"><v:SpacePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><v:DuplicatesPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UninstallViewModel}"><v:UninstallPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><v:OptimizePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RestorePointsViewModel}"><v:RestorePointsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FolderMoveViewModel}"><v:FolderMovePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemRelocationViewModel}"><v:SystemRelocationPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StartupViewModel}"><v:StartupPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AutoCleanViewModel}"><v:AutoCleanPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportViewModel}"><v:ReportPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutPage/></DataTemplate>

    <DataTemplate x:Key="NavItemTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" Width="22"/>
        <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="FooterNavTemplate">
      <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"/>
    </DataTemplate>
    <Style x:Key="FooterNavButton" TargetType="ListBoxItem" BasedOn="{StaticResource NavButton}">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Brand (also drag area) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,12,16,10" Height="44">
          <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentGradientBrush}">
            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="17" Foreground="White"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="DiskPro" FontSize="15" FontWeight="Bold"/>
            <TextBlock Text="C盘清理大师" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>

        <!-- Footer nav -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
          <Border Style="{StaticResource Divider}" Margin="18,6,18,6"/>
          <ListBox ItemsSource="{Binding FooterNav}" SelectedItem="{Binding SelectedFooter}" Margin="12,0"
                   ItemContainerStyle="{StaticResource FooterNavButton}" ItemTemplate="{StaticResource FooterNavTemplate}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </StackPanel>

        <!-- Main nav (grouped) -->
        <ListBox ItemsSource="{Binding NavView}" SelectedItem="{Binding SelectedMain}"
                 ItemContainerStyle="{StaticResource NavButton}" ItemTemplate="{StaticResource NavItemTemplate}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="24,10,0,4"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ================= Main area ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <DockPanel Grid.Row="0" Background="Transparent">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource TitleBarButton}" Content="{Binding ThemeGlyph}" FontSize="13" ToolTip="切换深色 / 浅色主题" Command="{Binding ToggleThemeCommand}"/>
          <Button Style="{StaticResource TitleBarButton}" Content="&#xE713;" FontSize="13" ToolTip="设置" Command="{Binding GoCommand}" CommandParameter="settings"/>
          <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="4,0"/>
          <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="最小化" Click="Min_Click"/>
          <Button x:Name="MaxBtn" Style="{StaticResource TitleBarButton}" Content="&#xE922;" ToolTip="最大化" Click="Max_Click"/>
          <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" ToolTip="关闭" Click="Close_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
          <Border Style="{StaticResource Badge}" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,8,0"
                  Visibility="{Binding DryRun, Converter={StaticResource BoolToVis}}" ToolTip="仅预览模式：所有删除操作只记录日志，不会真正删除。可在设置中关闭。">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource WarningBrush}" Margin="0,0,5,0"/>
              <TextBlock Text="仅预览模式" Foreground="{DynamicResource WarningBrush}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Badge}" Background="{DynamicResource DangerSoftBrush}"
                  Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}" ToolTip="未以管理员身份运行，部分系统级清理将被跳过">
            <TextBlock Text="未以管理员运行" Foreground="{DynamicResource DangerBrush}"/>
          </Border>
        </StackPanel>
      </DockPanel>

      <!-- Page header -->
      <StackPanel Grid.Row="1" Margin="32,4,32,18">
        <TextBlock Style="{StaticResource H1}" Text="{Binding CurrentPage.Title}"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{Binding CurrentPage.Subtitle}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </StackPanel>

      <!-- Page content -->
      <ContentControl x:Name="PageHost" Grid.Row="2" Margin="32,0,32,20" Content="{Binding CurrentPage}" Focusable="False"/>

      <!-- Toasts -->
      <StackPanel x:Name="ToastPanel" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Panel.ZIndex="50"/>
    </Grid>

    <!-- Modal overlay -->
    <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="100" Background="{DynamicResource OverlayBrush}">
      <ContentPresenter x:Name="OverlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"/>
    </Grid>
  </Grid>
</Window>
