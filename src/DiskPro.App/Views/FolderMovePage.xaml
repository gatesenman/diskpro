<UserControl x:Class="DiskPro.App.Views.FolderMovePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
      <WrapPanel>
        <TextBlock Text="目标位置" Style="{StaticResource ToolbarLabel}"/>
        <ComboBox ItemsSource="{Binding Drives}" IsEditable="True" Text="{Binding TargetRoot, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        <Button Content="浏览…" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}" Margin="6,0,16,0"/>
        <CheckBox Content="使用目录联接（Junction）代替系统重定向" IsChecked="{Binding UseJunction}" VerticalAlignment="Center"/>
        <Button Content="统计大小" Style="{StaticResource SecondaryButton}" Command="{Binding MeasureCommand}" Margin="16,0,0,0"/>
        <Button Content="开始搬家" Style="{StaticResource PrimaryButton}" Command="{Binding MoveCommand}" Margin="8,0,0,0"/>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" MaxHeight="200">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="回滚所选" Style="{StaticResource SecondaryButton}" Command="{Binding RollbackCommand}"/>
          <TextBlock Text="搬家记录（可回滚）" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock><Run Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding PreviousPath, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding NewPath, Mode=OneWay}"/></TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource ListCard}">
      <DataGrid ItemsSource="{Binding Folders}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="文件夹" Binding="{Binding DisplayName, Mode=OneWay}" Width="90" IsReadOnly="True"/>
          <DataGridTextColumn Header="当前位置" Binding="{Binding CurrentPath, Mode=OneWay}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" Width="100" IsReadOnly="True"/>
          <DataGridTextColumn Header="状态" Binding="{Binding LocationText, Mode=OneWay}" Width="100" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
