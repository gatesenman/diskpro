<UserControl x:Class="DiskPro.App.Views.SystemRelocationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Background="{DynamicResource WarningSoftBrush}" BorderThickness="0" Padding="16,12"
                Visibility="{Binding HasOtherDrive, Converter={StaticResource InverseBoolToVis}}">
          <TextBlock Text="未检测到 C 盘以外的本地固定磁盘，无法迁移虚拟内存。可在下方为 TEMP 指定其他位置。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
        </Border>
        <!-- Pagefile -->
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
              <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel>
              <TextBlock Text="虚拟内存（pagefile.sys）" Style="{StaticResource H2}"/>
              <TextBlock Text="{Binding PageSizeText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"><Run Text="当前配置："/><Run Text="{Binding PagingText, Mode=OneWay}"/></TextBlock>
              <WrapPanel>
                <TextBlock Text="目标磁盘" Style="{StaticResource ToolbarLabel}"/>
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding TargetDrive}" Width="100" Margin="0,0,16,8"/>
                <TextBlock Text="初始(MB)" Style="{StaticResource ToolbarLabel}"/>
                <TextBox Text="{Binding InitialMb}" Width="80" Margin="0,0,16,8"/>
                <TextBlock Text="最大(MB)" Style="{StaticResource ToolbarLabel}"/>
                <TextBox Text="{Binding MaxMb}" Width="80" Margin="0,0,16,8"/>
                <CheckBox Content="C 盘保留小页面文件（保留蓝屏转储能力）" IsChecked="{Binding KeepSmallOnSystem}" Margin="0,0,0,8"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="迁移虚拟内存" Command="{Binding MovePagefileCommand}"/>
                <Button Content="还原为系统自动管理" Command="{Binding RestorePagefileCommand}" Margin="8,0,0,0"/>
                <TextBlock Text="修改需重启后生效" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <!-- TEMP -->
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
              <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel>
              <TextBlock Text="临时文件夹（用户 TEMP / TMP）" Style="{StaticResource H2}"/>
              <TextBlock Text="{Binding TempSizeText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"><Run Text="当前位置："/><Run Text="{Binding TempText, Mode=OneWay}"/></TextBlock>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="新位置" Style="{StaticResource ToolbarLabel}"/>
                <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseTempCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding TempTarget, UpdateSourceTrigger=PropertyChanged}"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="迁移临时文件夹" Command="{Binding MoveTempCommand}"/>
                <Button Content="恢复默认位置" Command="{Binding RestoreTempCommand}" Margin="8,0,0,0"/>
                <TextBlock Text="重新登录后对所有程序生效" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="桌面、文档、下载等个人文件夹的迁移请使用“文件夹搬家”。所有修改均会备份原设置，可一键还原。" Style="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
