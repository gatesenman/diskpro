<UserControl x:Class="DiskPro.App.Views.BusyBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" MinHeight="28" Padding="14,0"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="12,0,0,0"/>
      <Grid DockPanel.Dock="Left" Width="18" Margin="0,0,10,0" VerticalAlignment="Center">
        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform><RotateTransform x:Name="spin"/></TextBlock.RenderTransform>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2"/></Storyboard></BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>
      </Grid>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12"/>
        <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
