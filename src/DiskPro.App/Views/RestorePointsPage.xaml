<UserControl x:Class="DiskPro.App.Views.RestorePointsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DiskPro.App.Views">
  <DockPanel>
    <v:BusyBar DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardFlat}">
        <StackPanel>
          <TextBlock Text="创建新的还原点" Style="{StaticResource H3}"/>
          <TextBlock Text="还原点会记录系统文件与注册表状态，出现问题时可通过“系统还原”回到此刻。" Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="立即创建"/></StackPanel>
            </Button>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardFlat}">
        <StackPanel>
          <TextBlock Text="卷影副本存储（C 盘）" Style="{StaticResource H3}"/>
          <TextBlock Text="{Binding StorageText}" Style="{StaticResource Muted}" Margin="0,8,0,10"/>
          <Button Style="{StaticResource GhostButton}" Content="打开“系统保护”设置 ›" HorizontalAlignment="Left" Padding="0" Command="{Binding OpenSysPropCommand}"/>
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
        <Button Style="{StaticResource DangerButton}" Content="删除所选还原点" Command="{Binding DeleteCommand}"/>
      </StackPanel>
      <TextBlock Text="现有还原点" Style="{StaticResource H2}" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Style="{StaticResource ListCard}">
      <Grid>
        <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" SelectionMode="Single" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="编号" Binding="{Binding SequenceNumber}" Width="70"/>
            <DataGridTextColumn Header="创建时间" Binding="{Binding Created, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="110"/>
            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource EmptyState}" Tag="&#xE777;" Visibility="{Binding Points.Count, Converter={StaticResource ZeroToVis}}">
          <TextBlock Text="暂无系统还原点。系统保护关闭时无法创建，可点击右上方链接开启。" Style="{StaticResource Muted}" MaxWidth="420" TextAlignment="Center"/>
        </ContentControl>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
