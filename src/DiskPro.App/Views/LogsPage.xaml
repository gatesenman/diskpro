<UserControl x:Class="DiskPro.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="刷新" Command="{Binding ReloadCommand}"/>
        <Button DockPanel.Dock="Left" Content="打开日志目录" Command="{Binding OpenDirCommand}" Margin="8,0,0,0"/>
        <TextBlock Text="{Binding LogDir}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource ListCard}">
      <Grid>
        <DataGrid ItemsSource="{Binding Entries}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', Mode=OneWay}" Width="160"/>
            <DataGridTextColumn Header="级别" Binding="{Binding Level, Mode=OneWay}" Width="80"/>
            <DataGridTextColumn Header="类别" Binding="{Binding Category, Mode=OneWay}" Width="120"/>
            <DataGridTemplateColumn Header="内容" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" Style="{StaticResource CellTrim}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <ContentControl Style="{StaticResource EmptyState}" Tag="&#xE8A5;" Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVis}}">
          <TextBlock Text="暂无日志" Style="{StaticResource Muted}"/>
        </ContentControl>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
